<IfModule mod_rewrite.c>
    RewriteEngine On

    # Do not rewrite a request that is already inside /public.
    RewriteRule ^public(?:/|$) - [L]

    # Root request goes straight to Laravel's front controller.
    RewriteRule ^$ public/index.php [L]

    # Static files and all other paths are resolved inside /public.
    RewriteRule ^(.+)$ public/$1 [L]
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Requests already routed into /public must not be rewritten again.
    RewriteRule ^public(?:/|$) - [L]

    # Serve real public files/directories (CSS, JS, images, storage) directly.
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
    RewriteRule ^(.+)$ public/$1 [L]

    # Everything else is a Laravel route.
    RewriteRule ^ public/index.php [L,QSA]
</IfModule>
